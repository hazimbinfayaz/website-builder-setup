# Copy this file to .env for local testing. In Netlify, add the same names under
# Site configuration > Environment variables. Never commit the real .env file.

# Passwords for the private collection, separated by commas
ACCESS_PASSWORDS=chinar

# A long random string that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Optional: how many days someone stays signed in
SESSION_DAYS=30

# Optional: email password requests to you via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=contact@kwongposh.in
FROM_EMAIL=
